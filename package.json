{
  "name": "dsh-live-doc",
  "version": "1.1.0",
  "description": "Live co-editing for DeepSeek Harness: the agent writes, you edit the same document in a real-time panel, and the agent reads your edits before it writes again. Exports .docx with no Office installation.",
  "type": "module",
  "main": "./src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./src/client/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "verify": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "docx",
    "word",
    "live-editing",
    "collaborative-editing",
    "office"
  ],
  "author": "jiayiliust-ops",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiayiliust-ops/dsh-live-doc.git"
  },
  "homepage": "https://github.com/jiayiliust-ops/dsh-live-doc#readme",
  "bugs": {
    "url": "https://github.com/jiayiliust-ops/dsh-live-doc/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.3.0-0"
    }
  }
}
